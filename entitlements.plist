<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- System Events adds and removes login items: the hardened runtime of a
	     Developer ID build otherwise refuses to send it Apple Events. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
